#!/bin/bash
# Garante o bloqueio do nginx (vd-bloqueio.conf + vd-bloqueio.inc) em todos os sites do Hestia, também nos novos, e recarrega
# o nginx só se algo mudou. Se a configuração ficar inválida, desfaz tudo e avisa (nunca deixa o nginx em baixo).
# Corre de 10 em 10 minutos (/etc/cron.d/vd-guarda).
export LC_ALL=C
INC=/etc/nginx/vd-bloqueio.inc
[ -f "$INC" ] && [ -f /etc/nginx/conf.d/vd-bloqueio.conf ] || exit 0
MUDOU=0
for d in /home/*/conf/web/*/; do
  for f in nginx.conf nginx.ssl.conf; do
    [ -f "$d$f" ] || continue
    grep -q "${f}_\*" "$d$f" || continue          # o vhost tem de aceitar ficheiros ${f}_*
    alvo="${d}${f}_vd-bloqueio"
    if ! cmp -s "$INC" "$alvo"; then cp "$INC" "$alvo" && MUDOU=1; fi
  done
done
if [ "$MUDOU" = 1 ]; then
  if nginx -t >/dev/null 2>&1; then
    systemctl reload nginx && logger -t vd-bloqueio "bloqueio aplicado e nginx recarregado"
  else
    rm -f /home/*/conf/web/*/nginx.conf_vd-bloqueio /home/*/conf/web/*/nginx.ssl.conf_vd-bloqueio
    logger -t vd-bloqueio "nginx -t falhou: bloqueio desfeito"
    echo "O bloqueio do nginx deixou a configuração inválida e foi desfeito em $(hostname)." | mail -s "[vd-bloqueio] $(hostname) — configuração desfeita" silva.chamo@gmail.com 2>/dev/null
  fi
fi
exit 0
