#!/bin/bash
# vd-php-conta — PHP por conta (Silva, 23/10/2026): cada conta pode ter as suas próprias extensões PHP.
#
# LIMITES DE CPU E MEMÓRIA POR CONTA (Silva, 26/10/2026): o Hestia só limita os processos da própria conta (shell, cron); o PHP dos sites corre
# num serviço partilhado e ficava de fora, por isso uma conta podia gastar o CPU de todo o servidor. Agora toda a conta que tem limites no
# pacote (user.conf: CPU_QUOTA, CPU_QUOTA_PERIOD, MEMORY_LIMIT, SWAP_LIMIT) passa a ter o seu PHP-FPM dedicado, com as mesmas extensões do
# partilhado, e o serviço leva esses limites (CPUQuota, MemoryHigh, MemoryMax, MemorySwapMax). Uma conta que passa o seu CPU fica mais lenta,
# nunca derruba as outras. Contas com "unlimited" ficam no PHP-FPM partilhado. O cron (sincronizar) trata de contas novas e de limites que mudam.
#
# O PHP lê as extensões quando o serviço arranca, e o Hestia põe todas as contas num só PHP-FPM por versão; por isso o que muda para uma conta
# mudava para todas. Aqui, uma conta que escolhe extensões passa a ter um PHP-FPM só dela (um serviço "vd-php-fpm-<versão>-<conta>") com a sua
# própria lista de extensões; as outras contas ficam no PHP-FPM partilhado, sem mudar nada. O socket de cada site é o mesmo (o servidor web nem
# nota): o pool do Hestia limita-se a mudar de serviço.
#
# Uso (como root):
#   vd-php-conta estado <conta> <versão>              mostra: dedicado, ativas, disponiveis, essenciais (uma linha cada, módulos separados por vírgulas)
#   vd-php-conta aplicar <conta> <modulo,modulo,...>  a conta passa a ter exactamente estes módulos (mais os essenciais e o que eles exigem)
#   vd-php-conta repor <conta>                        a conta volta ao PHP-FPM partilhado
#   vd-php-conta sincronizar                          (cron) mantém as contas dedicadas em ordem: pools que o Hestia refez, versões mudadas…
#   vd-php-conta registo-erros                        põe o error_log/slow_log na pasta de cada site WordPress (VD_SIMULAR=1 só mostra)
#   vd-php-conta corrigir-hestia                      faz o Hestia ignorar as pastas das contas ao procurar o pool.d (ver abaixo); idempotente
#
# Variáveis para testes (sem systemd): VD_TESTE=1
set -u

ETC=${VD_ETC:-/etc/vd-php}
PHP=${VD_PHP:-/etc/php}
ARQ=$ETC/arquivo
LOG=${VD_LOG:-/var/log/vd-php-conta.log}
HESTIA=${VD_HESTIA:-/usr/local/hestia/bin}
UNIDADES=${VD_UNIDADES:-/etc/systemd/system}
# nunca se tiram: sem estes os sites deixam de funcionar (mysqli precisa do mysqlnd)
ESSENCIAIS="mysqlnd mysqli curl mbstring xml ctype"
USUARIOS=${VD_USUARIOS:-/usr/local/hestia/data/users}

mkdir -p "$ETC" "$ARQ" 2>/dev/null
log() { echo "$(date '+%F %T') $*" >> "$LOG" 2>/dev/null; }
erro() { echo "ERRO: $*" >&2; log "ERRO: $*"; exit 1; }

conta_valida() {
  [[ "$1" =~ ^[a-z0-9][a-z0-9_.-]{0,31}$ ]] || erro "conta inválida"
  id -u "$1" >/dev/null 2>&1 || erro "a conta não existe"
}
versao_valida() { [[ "$1" =~ ^[5-9]\.[0-9]$ ]] || erro "versão inválida"; [ -d "$PHP/$1/mods-available" ] || erro "o PHP $1 não está instalado"; }

# módulos que a versão tem (os pacotes instalados)
disponiveis() { ls "$PHP/$1/mods-available" 2>/dev/null | sed -n 's/\.ini$//p'; }
prioridade() { local p; p=$(sed -n 's/^; priority=\([0-9][0-9]*\).*/\1/p' "$PHP/$1/mods-available/$2.ini" 2>/dev/null | head -1); echo "${p:-20}"; }

# o que um módulo exige para carregar
dependencias() {
  case "$1" in
    mysqli) echo mysqlnd ;;
    pdo_mysql) echo pdo mysqlnd ;;
    pdo_sqlite|pdo_pgsql|pdo_odbc) echo pdo ;;
    dom|simplexml|xmlreader|xmlwriter|xsl) echo xml ;;
  esac
}

# --- limites da conta (vêm do pacote, copiados para o user.conf do Hestia) ---
valor_conta() { sed -n "s/^$2='\(.*\)'\$/\1/p" "$USUARIOS/$1/user.conf" 2>/dev/null | head -1; } # conta chave

# linhas de [Service] do systemd com os limites da conta (vazio = sem limites). O MemoryHigh abranda a conta; o MemoryMax (1,5x) só pára
# os processos dela se passar mesmo, sem tocar nas outras contas.
limites_unidade() { # conta
  local c=$1 cpu per mem swp bytes
  cpu=$(valor_conta "$c" CPU_QUOTA); per=$(valor_conta "$c" CPU_QUOTA_PERIOD); mem=$(valor_conta "$c" MEMORY_LIMIT); swp=$(valor_conta "$c" SWAP_LIMIT)
  if [[ "$cpu" =~ ^[1-9][0-9]*%$ ]]; then
    echo "CPUQuota=$cpu"
    [[ "$per" =~ ^[0-9]+(ms|s)$ ]] && echo "CPUQuotaPeriodSec=$per"
  fi
  if [[ "$mem" =~ ^[1-9][0-9]*[KMGT]?$ ]]; then
    echo "MemoryHigh=$mem"
    bytes=$(numfmt --from=iec "$mem" 2>/dev/null) && [ -n "$bytes" ] && echo "MemoryMax=$(( bytes + bytes / 2 ))"
    [[ "$swp" =~ ^[0-9]+[KMGT]?$ ]] && echo "MemorySwapMax=$swp"
  fi
  return 0
}
tem_limites() { [ -n "$(limites_unidade "$1")" ]; }
# os limites do serviço dedicado já não são os do pacote (o pacote ou a conta mudou)?
limites_diferentes() { # versão conta
  local f="$UNIDADES/$(unidade "$1" "$2").service" a b
  [ -f "$f" ] || return 0
  a=$(grep -E '^(CPUQuota|CPUQuotaPeriodSec|MemoryHigh|MemoryMax|MemorySwapMax)=' "$f" | sort)
  b=$(limites_unidade "$2" | sort)
  [ "$a" != "$b" ]
}

pool_da_conta() { grep -qE "^user[[:space:]]*=[[:space:]]*$2[[:space:]]*$" "$1"; } # ficheiro conta

# versões em que a conta tem pools (no PHP-FPM partilhado ou no dela)
versoes_da_conta() {
  local f
  for f in "$PHP"/*/fpm/pool.d/*.conf "$PHP"/*/fpm-contas/"$1"/pool.d/*.conf; do
    [ -f "$f" ] || continue
    pool_da_conta "$f" "$1" || continue
    echo "$f" | sed -n "s#^$PHP/\([0-9]\.[0-9]\)/.*#\1#p"
  done | sort -u
}

pools_partilhados() { # versão conta
  local f
  for f in "$PHP/$1"/fpm/pool.d/*.conf; do
    [ -f "$f" ] && pool_da_conta "$f" "$2" && echo "$f"
  done
}

unidade() { echo "vd-php-fpm-$1-$2"; }
pasta() { echo "$PHP/$1/fpm-contas/$2"; }
pidpartilhado() { echo "${VD_PID_PARTILHADO:-$PHP/$1/fpm/master.pid}"; }

# --- serviços (com systemd; em teste, processos soltos) ---
svc_ativo() { # unidade versão conta
  if [ -n "${VD_TESTE:-}" ]; then local p; p="$(pasta "$2" "$3")/master.pid"; [ -f "$p" ] && kill -0 "$(cat "$p")" 2>/dev/null; return; fi
  systemctl is-active --quiet "$1"
}
svc_recarregar_partilhado() { # versão
  if [ -n "${VD_TESTE:-}" ]; then local p; p=$(cat "$(pidpartilhado "$1")" 2>/dev/null); [ -n "$p" ] && kill -USR2 "$p"; sleep 1; return 0; fi
  systemctl reload "php$1-fpm" 2>/dev/null || systemctl restart "php$1-fpm"
}
svc_iniciar_ou_recarregar() { # unidade versão conta
  if [ -n "${VD_TESTE:-}" ]; then
    local d; d=$(pasta "$2" "$3")
    if svc_ativo "$1" "$2" "$3"; then kill -USR2 "$(cat "$d/master.pid")"; else PHP_INI_SCAN_DIR="$d/conf.d" "/usr/sbin/php-fpm$2" --daemonize --fpm-config "$d/php-fpm.conf" -c "$d/php.ini" 9>&-; fi
    sleep 1; return 0
  fi
  systemctl daemon-reload
  if systemctl is-active --quiet "$1"; then systemctl reload "$1" || systemctl restart "$1"; else systemctl enable --now "$1"; fi
}
svc_parar() { # unidade versão conta
  if [ -n "${VD_TESTE:-}" ]; then local p; p="$(pasta "$2" "$3")/master.pid"; [ -f "$p" ] && kill -QUIT "$(cat "$p")" 2>/dev/null; sleep 1; return 0; fi
  systemctl disable --now "$1" 2>/dev/null; rm -f "$UNIDADES/$1.service"; systemctl daemon-reload
}

# --- o PHP-FPM dedicado de uma conta, numa versão ---
gerar() { # versão conta  (módulos pedidos em $PEDIDOS)
  local v=$1 c=$2 d; d=$(pasta "$v" "$c")
  mkdir -p "$d/pool.d" "$d/conf.d"
  cp -f "$PHP/$v/fpm/php.ini" "$d/php.ini"
  cat > "$d/php-fpm.conf" <<EOF
[global]
pid = $d/master.pid
error_log = /var/log/php$v-fpm-$c.log
include=$d/pool.d/*.conf
EOF
  # o conjunto: pedidos + dependências + essenciais, só do que existe nesta versão
  local disp mod dep final=" " pedidos=${PEDIDOS:-}
  # conta só com limites (sem extensões escolhidas): as mesmas extensões que o PHP-FPM partilhado tem
  [ -n "${MODO_PARTILHADO:-}" ] && pedidos=$(ls "$PHP/$v/fpm/conf.d" 2>/dev/null | sed -n 's/^[0-9]*-\(.*\)\.ini$/\1/p' | tr '\n' ' ')
  disp=" $(disponiveis "$v" | tr '\n' ' ') "
  for mod in $pedidos $ESSENCIAIS; do
    for dep in $(dependencias "$mod") "$mod"; do
      [[ "$disp" == *" $dep "* ]] && [[ "$final" != *" $dep "* ]] && final="$final$dep "
    done
  done
  find "$d/conf.d" -maxdepth 1 -type l -delete
  for mod in $final; do ln -s "$PHP/$v/mods-available/$mod.ini" "$d/conf.d/$(prioridade "$v" "$mod")-$mod.ini"; done
  if [ -z "${VD_TESTE:-}" ]; then
    cat > "$UNIDADES/$(unidade "$v" "$c").service" <<EOF
[Unit]
Description=PHP $v FPM da conta $c (vd-php-conta: extensões e limites próprios)
After=network.target

[Service]
Type=notify
Environment=PHP_INI_SCAN_DIR=$d/conf.d
ExecStart=/usr/sbin/php-fpm$v --nodaemonize --fpm-config $d/php-fpm.conf -c $d/php.ini
ExecReload=/bin/kill -USR2 \$MAINPID
$(limites_unidade "$c")

[Install]
WantedBy=multi-user.target
EOF
  fi
}

# passa os pools da conta (nesta versão) do PHP-FPM partilhado para o dedicado; devolve 0 se mudou alguma coisa
mover_pools() { # versão conta
  local v=$1 c=$2 d f mudou=1; d=$(pasta "$v" "$c")
  for f in $(pools_partilhados "$v" "$c"); do
    mkdir -p "$ARQ/$v/$c"
    cp -f "$f" "$ARQ/$v/$c/$(basename "$f").$(date +%s)"
    mv -f "$f" "$d/pool.d/$(basename "$f")"
    mudou=0
  done
  return $mudou
}

# tira do dedicado os pools de sites que o Hestia já não tem, ou que passaram a outra versão do PHP.
# Sem o Hestia, ou com qualquer erro que não seja "o site não existe" (código 3), não se apaga nada.
limpar_pools() { # versão conta
  local v=$1 c=$2 d f dom out rc be; d=$(pasta "$v" "$c")
  [ -x "$HESTIA/v-list-web-domain" ] || return 0
  for f in "$d"/pool.d/*.conf; do
    [ -f "$f" ] || continue
    dom=$(basename "$f" .conf)
    out=$("$HESTIA/v-list-web-domain" "$c" "$dom" plain 2>/dev/null); rc=$?
    if [ $rc -eq 3 ]; then rm -f "$f"; log "$c: pool de $dom removido (o site já não existe)"; continue; fi
    [ $rc -eq 0 ] || continue
    be=$(echo "$out" | grep -o 'PHP-[0-9]_[0-9]' | head -1)
    if [ -n "$be" ] && [ "$be" != "PHP-${v/./_}" ]; then rm -f "$f"; log "$c: pool de $dom removido (agora usa $be)"; fi
  done
}

# Todo o pool dedicado tem um tempo máximo REAL por pedido (30/10/2026): o max_execution_time só conta CPU, e pedidos do editor do Elementor ficavam
# minutos presos, enchiam os 8 trabalhadores do pool e o site caía para os visitantes. O Hestia refaz os pools sem este ajuste (passagem de conta, mudar
# o PHP, reconstruir); aqui volta a pôr-se em cada passagem do sincronizar. Quem já tiver um valor próprio (ex.: workflow ops-php-tempo-limite) não é mexido.
TEMPO_LIMITE_PEDIDO=${VD_TEMPO_LIMITE:-90s}
garantir_tempo_limite() { # versão conta
  local f d; d=$(pasta "$1" "$2")
  for f in "$d"/pool.d/*.conf; do
    [ -f "$f" ] || continue
    grep -qE '^[[:space:]]*request_terminate_timeout[[:space:]]*=' "$f" && continue
    printf '\nrequest_terminate_timeout = %s\n' "$TEMPO_LIMITE_PEDIDO" >> "$f"
    log "$2: $(basename "$f") ganhou request_terminate_timeout = $TEMPO_LIMITE_PEDIDO"
  done
}

# Todo o pool dedicado grava os erros do PHP na pasta do site (30/10/2026, Silva: «o error_log tem limitações de registar erros, mas não devia»):
# public_html/error_log com TODOS os erros que importam (fatais, avisos, erros de análise, recuperáveis; fora ficam só as notas e os «deprecated», que
# enchem o ficheiro sem dizer nada) e public_html/slow_log com o rasto de todo o pedido com mais de 15 s. O workflow ops-php-erros-gravar só punha estas
# linhas num pool de cada vez e o Hestia refaz os pools sem elas (passagem de conta: o entrecamposblog.com passou de vdadmin para entrecampos e o registo
# deixou de existir); aqui voltam a pôr-se em cada passagem do sincronizar. Nível 7159 = E_ALL sem E_NOTICE, E_USER_NOTICE, E_DEPRECATED, E_USER_DEPRECATED.
# Os dois ficheiros ficam do dono da conta, negados à web (nginx.conf_erros) e rodados a 5 MB (logrotate, como no workflow). Devolve 0 se mudou algum pool.
NIVEL_ERROS=${VD_NIVEL_ERROS:-7159}
garantir_registo_erros() { # versão conta
  local v=$1 c=$2 f d dom raiz cn conf ini mudou=1 cop; d=$(pasta "$v" "$c"); conf="$d/php-fpm.conf"; ini="$d/php.ini"
  for f in "$d"/pool.d/*.conf; do
    [ -f "$f" ] || continue
    dom=$(basename "$f" .conf); raiz=/home/$c/web/$dom/public_html
    [ -d "$raiz" ] || continue
    # só os sites WordPress (Silva, 30/10/2026): os outros PHP e os sites Node.js/Next.js não levam isto
    [ -f "$raiz/wp-config.php" ] || [ -d "$raiz/wp-includes" ] || continue
    cop="$ARQ/$c-$dom.pool.$(date +%s)"
    # já certo (caminho desta conta, nível actual e rasto dos pedidos lentos): nada a fazer
    if grep -qF "php_admin_value[error_log] = $raiz/error_log" "$f" && grep -qE "^php_admin_value\[error_reporting\] = $NIVEL_ERROS\$" "$f" \
      && grep -qF "slowlog = $raiz/slow_log" "$f"; then
      [ -z "${VD_FALAR:-}" ] || echo "$c $dom: já certo"
      continue
    fi
    if [ -n "${VD_SIMULAR:-}" ]; then echo "$c $dom: POR ACTUALIZAR (o pool não grava o registo de erros na pasta do site)"; continue; fi
    # senão tira-se o que lá houver (o do Hestia manda os erros para /var/log, fora do alcance do gestor de ficheiros; o do workflow pode ser de outra conta
    # ou do nível antigo) e põe-se o bloco certo
    cp -p "$f" "$cop"
    sed -i -E '/^; vd-erros-inicio/,/^; vd-erros-fim/d; /^(php_admin_value|php_admin_flag)\[(log_errors|error_log|error_reporting)\] *=/d; /^(request_slowlog_timeout|slowlog) *=/d' "$f"
    { printf '\n; vd-erros-inicio (erros do PHP gravados na pasta do site)\nphp_admin_value[log_errors] = on\n'
      printf 'php_admin_value[error_log] = %s/error_log\nphp_admin_value[error_reporting] = %s\n' "$raiz" "$NIVEL_ERROS"
      printf 'request_slowlog_timeout = 15s\nslowlog = %s/slow_log\n; vd-erros-fim\n' "$raiz"; } >> "$f"
    if [ -z "${VD_TESTE:-}" ] && ! "/usr/sbin/php-fpm$v" -t -y "$conf" -c "$ini" >/dev/null 2>&1; then
      cp -p "$cop" "$f"; log "ERRO: $c: $dom: pool reposto (php-fpm -t falhou ao pôr o registo de erros)"; continue
    fi
    for a in error_log slow_log; do [ -f "$raiz/$a" ] || { touch "$raiz/$a"; chown "$c:$c" "$raiz/$a" 2>/dev/null; chmod 640 "$raiz/$a"; }; done
    cn=/home/$c/conf/web/$dom
    if [ -d "$cn" ] && [ ! -f "$cn/nginx.conf_erros" ]; then
      printf 'location ~ ^/(error_log|slow_log)$ {\n    return 404;\n}\n' > "$cn/nginx.conf_erros"; chown root:"$c" "$cn/nginx.conf_erros" 2>/dev/null
      NGINX_RECARREGAR=1
    fi
    log "$c: $dom: registo de erros do PHP em $raiz/error_log (nível $NIVEL_ERROS)"
    [ -z "${VD_FALAR:-}" ] || echo "$c $dom: registo de erros posto em $raiz/error_log (nível $NIVEL_ERROS)"
    mudou=0
  done
  [ -f /etc/logrotate.d/vd-erros-site ] || [ -n "${VD_TESTE:-}" ] || printf '/home/*/web/*/public_html/error_log /home/*/web/*/public_html/slow_log {\n    size 5M\n    rotate 2\n    compress\n    missingok\n    notifempty\n    copytruncate\n}\n' > /etc/logrotate.d/vd-erros-site 2>/dev/null
  return $mudou
}

# o nginx só se recarrega (suave, depois do teste) se se escreveu algum nginx.conf_erros novo
recarregar_nginx_se_preciso() {
  [ -n "${NGINX_RECARREGAR:-}" ] && [ -z "${VD_TESTE:-}" ] || return 0
  if nginx -t >/dev/null 2>&1; then systemctl reload nginx && log "nginx recarregado (registos de erros negados à web)" && { [ -z "${VD_FALAR:-}" ] || echo "nginx recarregado (suave)"; }
  else log "ERRO: nginx -t falhou; nginx.conf_erros novos não recarregados"; [ -z "${VD_FALAR:-}" ] || echo "ERRO: nginx -t falhou; nginx.conf_erros novos não recarregados"; fi
}

cmd_registo_erros() { # (VD_SIMULAR=1: só mostra o que faria)
  local d v c
  VD_FALAR=1
  for d in "$PHP"/*/fpm-contas/*; do
    [ -d "$d" ] || continue
    c=$(basename "$d"); v=$(echo "$d" | sed -n "s#^$PHP/\([0-9]\.[0-9]\)/.*#\1#p")
    if garantir_registo_erros "$v" "$c" && [ -z "${VD_SIMULAR:-}" ]; then
      svc_iniciar_ou_recarregar "$(unidade "$v" "$c")" "$v" "$c" && echo "$c: PHP $v recarregado (suave)"
    fi
  done
  recarregar_nginx_se_preciso
}

aplicar_versao() { # versão conta
  local v=$1 c=$2 d u; d=$(pasta "$v" "$c"); u=$(unidade "$v" "$c")
  gerar "$v" "$c"
  local mudou_partilhado=1
  mover_pools "$v" "$c" && mudou_partilhado=0
  limpar_pools "$v" "$c"
  garantir_tempo_limite "$v" "$c"
  garantir_registo_erros "$v" "$c" || true
  if ! ls "$d"/pool.d/*.conf >/dev/null 2>&1; then
    svc_parar "$u" "$v" "$c"; rm -rf "$d"; log "$c: sem sites no PHP $v, serviço dedicado removido"; return 0
  fi
  [ $mudou_partilhado -eq 0 ] && svc_recarregar_partilhado "$v"
  svc_iniciar_ou_recarregar "$u" "$v" "$c"
  log "$c: PHP $v dedicado com $(ls "$d/conf.d" | wc -l) módulos"
}

cmd_aplicar() { # conta módulos
  local c=$1 v mod pedidos=""
  conta_valida "$c"
  for mod in $(echo "$2" | tr ',' ' '); do [[ "$mod" =~ ^[a-z0-9_]{2,30}$ ]] && pedidos="$pedidos $mod"; done
  printf '%s\n' $pedidos > "$ETC/$c.exts"
  PEDIDOS="$pedidos"; unset MODO_PARTILHADO
  local vs; vs=$(versoes_da_conta "$c")
  [ -z "$vs" ] && erro "a conta não tem sites com PHP"
  for v in $vs; do aplicar_versao "$v" "$c"; done
}

cmd_repor() { # conta
  local c=$1 v d f u
  conta_valida "$c"
  for d in "$PHP"/*/fpm-contas/"$c"; do
    [ -d "$d" ] || continue
    v=$(echo "$d" | sed -n "s#^$PHP/\([0-9]\.[0-9]\)/.*#\1#p"); u=$(unidade "$v" "$c")
    svc_parar "$u" "$v" "$c"
    for f in "$d"/pool.d/*.conf; do [ -f "$f" ] && mv -f "$f" "$PHP/$v/fpm/pool.d/$(basename "$f")"; done
    svc_recarregar_partilhado "$v"
    rm -rf "$d"
  done
  rm -f "$ETC/$c.exts"
  log "$c: de volta ao PHP-FPM partilhado"
  # com limites no pacote a conta não pode ficar no partilhado: volta logo ao dedicado, com as extensões do partilhado
  if tem_limites "$c"; then
    PEDIDOS=""; MODO_PARTILHADO=1
    for v in $(versoes_da_conta "$c"); do aplicar_versao "$v" "$c"; done
    unset MODO_PARTILHADO
  fi
}

cmd_estado() { # conta versão
  local c=$1 v=$2 d
  conta_valida "$c"; versao_valida "$v"
  d=$(pasta "$v" "$c")
  if [ -d "$d/conf.d" ] && [ -f "$ETC/$c.exts" ]; then
    echo "dedicado=sim"
    echo "ativas=$(ls "$d/conf.d" | sed -n 's/^[0-9]*-\(.*\)\.ini$/\1/p' | paste -sd, -)"
  else
    echo "dedicado=nao"
    echo "ativas=$(ls "$PHP/$v/fpm/conf.d" 2>/dev/null | sed -n 's/^[0-9]*-\(.*\)\.ini$/\1/p' | paste -sd, -)"
  fi
  echo "disponiveis=$(disponiveis "$v" | paste -sd, -)"
  echo "essenciais=$(echo $ESSENCIAIS | tr ' ' ',')"
}

# O Hestia procura as pastas pool.d do PHP e só aceita uma; com o PHP por conta (fpm-contas/*) acha várias e falha («php-fpm pool doesn't
# exist») ao passar um domínio para outra conta, ao criar ou reconstruir sites (30/10/2026: três sites ficaram em baixo e o PHP partilhado
# parou). Aqui a procura passa a ignorar as pastas das contas. Idempotente, com cópia de cada ficheiro em $ARQ; se a sintaxe falhar repõe-no.
# Corre a cada 5 minutos (sincronizar), por isso um upgrade do Hestia que o desfaça é refeito sozinho.
corrigir_hestia() {
  local raiz=${VD_HESTIA_RAIZ:-/usr/local/hestia} f cop
  [ -d "$raiz/func" ] || return 0
  for f in "$raiz"/func/* "$raiz"/bin/v-*; do
    [ -f "$f" ] || continue
    grep -F -- '-name "*fpm.d" \)' "$f" 2>/dev/null | grep -vqF 'fpm-contas' || continue
    cop="$ARQ/$(basename "$f").hestia.$(date +%s)"
    cp -p "$f" "$cop"
    sed -i 's#-name "\*fpm\.d" \\)#-name "*fpm.d" \\) -not -path "*/fpm-contas/*"#' "$f"
    if bash -n "$f" 2>/dev/null; then log "hestia: procura do pool.d corrigida em $f"; else cp -p "$cop" "$f"; log "ERRO: hestia: $f reposto (sintaxe)"; fi
  done
}

cmd_sincronizar() {
  local c v d f tem
  corrigir_hestia
  # o PHP-FPM dedicado escreve os registos em /var/log/php<versão>-fpm-<conta>.log: roda-os (uma vez, aqui, para não depender do deploy)
  [ -f /etc/logrotate.d/vd-php-fpm ] || [ -n "${VD_TESTE:-}" ] || printf '/var/log/php*-fpm-*.log {\n    weekly\n    rotate 4\n    compress\n    missingok\n    notifempty\n    copytruncate\n}\n' > /etc/logrotate.d/vd-php-fpm 2>/dev/null
  # as contas com extensões escolhidas e as que têm limites no pacote
  for c in $( { for f in "$ETC"/*.exts; do [ -f "$f" ] && basename "$f" .exts; done; ls "$USUARIOS" 2>/dev/null; } | sort -u ); do
    [[ "$c" =~ ^[a-z0-9][a-z0-9_.-]{0,31}$ ]] || continue
    id -u "$c" >/dev/null 2>&1 || continue
    unset MODO_PARTILHADO; PEDIDOS=""
    if [ -f "$ETC/$c.exts" ]; then PEDIDOS=$(tr '\n' ' ' < "$ETC/$c.exts")
    elif tem_limites "$c"; then MODO_PARTILHADO=1
    else
      # sem extensões próprias e sem limites: se ainda tinha o PHP-FPM dedicado (de limites que já não existem), volta ao partilhado
      tem=1; for d in "$PHP"/*/fpm-contas/"$c"; do [ -d "$d" ] && tem=0; done
      [ $tem -eq 0 ] && cmd_repor "$c"
      continue
    fi
    # o que o Hestia refez no partilhado, serviço parado ou limites que mudaram
    for v in $(versoes_da_conta "$c"); do
      if [ -n "$(pools_partilhados "$v" "$c")" ] || ! svc_ativo "$(unidade "$v" "$c")" "$v" "$c" || limites_diferentes "$v" "$c"; then aplicar_versao "$v" "$c"; fi
    done
    for d in "$PHP"/*/fpm-contas/"$c"; do
      [ -d "$d" ] || continue
      v=$(echo "$d" | sed -n "s#^$PHP/\([0-9]\.[0-9]\)/.*#\1#p")
      limpar_pools "$v" "$c"
      ls "$d"/pool.d/*.conf >/dev/null 2>&1 || { svc_parar "$(unidade "$v" "$c")" "$v" "$c"; rm -rf "$d"; log "$c: sem sites no PHP $v, serviço dedicado removido"; continue; }
      # pools que ficaram sem o registo de erros (ex.: refeitos pelo Hestia numa passagem de conta): volta a pôr-se e recarrega-se só esta conta
      garantir_registo_erros "$v" "$c" && svc_iniciar_ou_recarregar "$(unidade "$v" "$c")" "$v" "$c"
    done
  done
  recarregar_nginx_se_preciso
}

cd / || exit 1
exec 9>/run/vd-php-conta.lock 2>/dev/null || exec 9>/tmp/vd-php-conta.lock
flock -w 120 9 || erro "ocupado"
case "${1:-}" in
  estado) cmd_estado "${2:-}" "${3:-}" ;;
  aplicar) cmd_aplicar "${2:-}" "${3:-}" ;;
  repor) cmd_repor "${2:-}" ;;
  sincronizar) cmd_sincronizar ;;
  corrigir-hestia) corrigir_hestia ;;
  registo-erros) cmd_registo_erros ;;
  *) echo "uso: vd-php-conta estado|aplicar|repor|sincronizar|corrigir-hestia|registo-erros …" >&2; exit 2 ;;
esac
